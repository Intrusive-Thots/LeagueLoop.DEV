# ── Dependencies ────────────────────────────────────────────────────────
node_modules/
.venv/
venv/
__pycache__/

# ── User data ───────────────────────────────────────────────────────────
# These hold account credentials, settings and match history. They belong in
# %LOCALAPPDATA%\LeagueLoop, and `get_data_dir()` puts them there — but they
# are listed anyway so that an older build, a stray copy, or a `git add -A`
# can never put the account store in the repository.
accounts.json
config.json
leagueloop.db
leagueloop.db-shm
leagueloop.db-wal
sessions/
*.moved-to-appdata
*.superseded

# ── Logs and temp files ─────────────────────────────────────────────────
*.log
*.tmp
*.swp

# ── Environment ─────────────────────────────────────────────────────────
.env
.env.local
*.env.*

# ── Editors ─────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Build artifacts ─────────────────────────────────────────────────────
dist/
build/
*.pyc
*.pyo
*.pyd
*.class
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out
.PyInstaller/

# ── Coverage / test ─────────────────────────────────────────────────────
coverage/
htmlcov/
.coverage
.pytest_cache/

# ── Local caches & scratch ──────────────────────────────────────────────
cache/
scratch/
Claude outputs/
tools/last_test_run.txt
tools/commit_message.txt
