{
    "brand": {
        "name": "AutoLock",
        "identity": "arcane_tech"
    },
    "colors": {
        "background": {
            "app": "#091428",
            "panel": "#0A1428",
            "card": "#0F1923",
            "card_hover": "#132030",
            "card_active": "#162438",
            "input": "#0A1220",
            "overlay": "rgba(0,0,0,0.6)"
        },
        "text": {
            "primary": "#F8F6F0",
            "secondary": "#F0C674",
            "muted": "#A8B8CC",
            "disabled": "#708090"
        },
        "accent": {
            "primary": "#C8AA6E",
            "gold": "#C8AA6E",
            "blue": "#0BC6E3",
            "green": "#2ECC71",
            "red": "#E74C3C",
            "purple": "#9B59B6"
        },
        "state": {
            "success": "#2ECC71",
            "warning": "#F1C40F",
            "danger": "#E74C3C",
            "info": "#3498DB",
            "hover": "#1C2630"
        }
    },
    "gradients": {
        "panel": [
            "#0E141B",
            "#0A0F14"
        ],
        "card": [
            "#141E28",
            "#0E141B"
        ],
        "header": [
            "#111A23",
            "#0A0F14"
        ],
        "gold_glow": [
            "#C8A45D33",
            "#00000000"
        ],
        "blue_glow": [
            "#3FA9F533",
            "#00000000"
        ]
    },
    "shadows": {
        "small": "0 2px 4px rgba(0,0,0,0.4)",
        "medium": "0 4px 8px rgba(0,0,0,0.45)",
        "large": "0 8px 16px rgba(0,0,0,0.5)",
        "floating_window": "0 12px 32px rgba(0,0,0,0.6)",
        "popup": "0 6px 20px rgba(0,0,0,0.5)",
        "context_menu": "0 4px 12px rgba(0,0,0,0.5)"
    },
    "elevation": {
        "level0": {
            "shadow": "none",
            "blur": 0
        },
        "level1": {
            "shadow": "0 2px 6px rgba(0,0,0,0.4)",
            "blur": 6
        },
        "level2": {
            "shadow": "0 6px 16px rgba(0,0,0,0.45)",
            "blur": 12
        },
        "level3": {
            "shadow": "0 10px 28px rgba(0,0,0,0.5)",
            "blur": 18
        },
        "level4": {
            "shadow": "0 16px 40px rgba(0,0,0,0.6)",
            "blur": 26
        }
    },
    "radius": {
        "xs": 4,
        "sm": 8,
        "md": 12,
        "lg": 16,
        "xl": 16,
        "pill": 999
    },
    "spacing": {
        "xs": 4,
        "sm": 8,
        "md": 12,
        "lg": 16,
        "xl": 24,
        "xxl": 32,
        "xxxl": 48
    },
    "borders": {
        "subtle": "1px solid #1E2328",
        "soft": "1px solid #1A2332",
        "strong": "1px solid #3C3C41",
        "gold": "1px solid #C8AA6E",
        "card": "1px solid #1A2332",
        "card_gold": "1px solid #1E1E2D"
    },
    "buttons": {
        "primary": {
            "bg": "#C8AA6E",
            "text": "#091428",
            "hover": "#D3B679",
            "glow": "0 0 12px rgba(200,170,110,0.6)"
        },
        "secondary": {
            "bg": "transparent",
            "text": "#C8AA6E",
            "hover": "#1E2328",
            "glow": "0 0 10px rgba(200,170,110,0.4)"
        },
        "danger": {
            "bg": "transparent",
            "text": "#E74C3C",
            "hover": "#C0392B",
            "glow": "0 0 12px rgba(231,76,60,0.6)"
        },
        "ghost": {
            "bg": "transparent",
            "text": "#F0E6D2",
            "hover": "#1E2328"
        }
    },
    "animations": {
        "fade": {
            "duration": 150,
            "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
        },
        "slide": {
            "duration": 200,
            "offset_px": 20,
            "easing": "cubic-bezier(0, 0, 0.2, 1)"
        },
        "scale": {
            "duration": 150,
            "start_scale": 0.95,
            "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)"
        },
        "hover_lift": {
            "duration": 120,
            "lift_px": 2,
            "scale": 1.02,
            "easing": "ease-out"
        },
        "button_press": {
            "duration": 80,
            "scale": 0.97,
            "easing": "ease-in-out"
        },
        "window_open": {
            "duration": 250,
            "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
        },
        "tooltip": {
            "duration": 100,
            "delay_ms": 300,
            "easing": "ease-out"
        },
        "notification": {
            "duration": 300,
            "easing": "cubic-bezier(0.175, 0.885, 0.32, 1.275)"
        }
    },
    "icons": {
        "style": "glyph_glow",
        "glow_color": "#C8A45D",
        "glow_intensity": 0.6
    },
    "typography": {
        "font_primary": "Segoe UI",
        "font_secondary": "Beaufort for LoL",
        "weights": {
            "regular": "normal",
            "medium": "normal",
            "bold": "bold"
        },
        "h1": {
            "family": "Beaufort for LoL",
            "size": 24,
            "weight": "bold"
        },
        "h2": {
            "family": "Beaufort for LoL",
            "size": 18,
            "weight": "bold"
        },
        "h3": {
            "family": "Beaufort for LoL",
            "size": 14,
            "weight": "bold"
        },
        "body": {
            "family": "Segoe UI",
            "size": 12,
            "weight": "normal"
        },
        "caption": {
            "family": "Segoe UI",
            "size": 11,
            "weight": "normal"
        },
        "small": {
            "family": "Segoe UI",
            "size": 10,
            "weight": "normal"
        },
        "numeric": {
            "family": "Segoe UI",
            "size": 13,
            "weight": "bold"
        }
    }
}